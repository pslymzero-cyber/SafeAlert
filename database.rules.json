{
  "rules": {
    ".read": false,
    ".write": false,
    "version": {
      ".read": true,
      ".write": false
    },
    "echo_calib": {
      ".read": "auth != null",
      ".write": false
    },
    "$site": {
      "version": {
        ".read": true,
        ".write": false
      },
      "alerts": {
        "$a": {
          "$b": {
            ".write": "auth != null && !data.exists() && $site.matches(/^[A-Za-z0-9_-]{1,32}$/) && $a.matches(/^[0-9]{8}$/)",
            ".validate": "!($a.matches(/^[0-9]{8}$/) && !$b.matches(/^[0-9]{8}$/)) || newData.hasChildren(['timestamp','deviceId','walkerId','rssi','alertLevel','myRole','peerRole','site','uid'])",
            "timestamp": {
              ".validate": "$a.matches(/^[0-9]{8}$/) && !$b.matches(/^[0-9]{8}$/) && newData.isNumber()"
            },
            "deviceId": {
              ".validate": "$a.matches(/^[0-9]{8}$/) && !$b.matches(/^[0-9]{8}$/) && newData.isString() && newData.val().length <= 128"
            },
            "walkerId": {
              ".validate": "$a.matches(/^[0-9]{8}$/) && !$b.matches(/^[0-9]{8}$/) && newData.isString() && newData.val().length <= 128"
            },
            "rssi": {
              ".validate": "$a.matches(/^[0-9]{8}$/) && !$b.matches(/^[0-9]{8}$/) && newData.isNumber() && newData.val() >= -150 && newData.val() <= 20"
            },
            "alertLevel": {
              ".validate": "$a.matches(/^[0-9]{8}$/) && !$b.matches(/^[0-9]{8}$/) && newData.isString() && newData.val().length <= 32"
            },
            "myRole": {
              ".validate": "$a.matches(/^[0-9]{8}$/) && !$b.matches(/^[0-9]{8}$/) && newData.isString() && newData.val().length <= 32"
            },
            "peerRole": {
              ".validate": "$a.matches(/^[0-9]{8}$/) && !$b.matches(/^[0-9]{8}$/) && newData.isString() && newData.val().length <= 32"
            },
            "site": {
              ".validate": "$a.matches(/^[0-9]{8}$/) && !$b.matches(/^[0-9]{8}$/) && newData.isString() && newData.val().length <= 32"
            },
            "uid": {
              ".validate": "$a.matches(/^[0-9]{8}$/) && !$b.matches(/^[0-9]{8}$/) && newData.isString() && newData.val() === auth.uid"
            },
            "$c": {
              ".write": "auth != null && !data.exists() && $site.matches(/^[A-Za-z0-9_-]{1,32}$/) && $b.matches(/^[0-9]{8}$/)",
              ".validate": "$b.matches(/^[0-9]{8}$/) && newData.hasChildren(['timestamp','deviceId','walkerId','rssi','alertLevel','myRole','peerRole','site','uid'])",
              "timestamp": {
                ".validate": "newData.isNumber()"
              },
              "deviceId": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "walkerId": {
                ".validate": "newData.isString() && newData.val().length <= 128"
              },
              "rssi": {
                ".validate": "newData.isNumber() && newData.val() >= -150 && newData.val() <= 20"
              },
              "alertLevel": {
                ".validate": "newData.isString() && newData.val().length <= 32"
              },
              "myRole": {
                ".validate": "newData.isString() && newData.val().length <= 32"
              },
              "peerRole": {
                ".validate": "newData.isString() && newData.val().length <= 32"
              },
              "site": {
                ".validate": "newData.isString() && newData.val().length <= 32"
              },
              "uid": {
                ".validate": "newData.isString() && newData.val() === auth.uid"
              },
              "floor": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{1,4}$/)"
              },
              "proc": {
                ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{1,4}$/)"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        }
      },
      "beacon_share": {
        "$sc": {
          ".read": "auth != null",
          "$key": {
            ".write": "auth != null && $site.matches(/^[A-Za-z0-9_-]{1,32}$/) && $sc.matches(/^[A-Z0-9_-]{1,12}$/)",
            ".validate": "newData.hasChildren(['name','profilesJson','count','sender','timestamp','uid'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "profilesJson": {
              ".validate": "newData.isString() && newData.val().length <= 65536"
            },
            "count": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "sender": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "timestamp": {
              ".validate": "newData.isNumber()"
            },
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "sos": {
        "$sc": {
          ".read": "auth != null",
          ".indexOn": ["createdAt"],
          "$id": {
            ".write": "auth != null && $site.matches(/^[A-Za-z0-9_-]{1,32}$/) && $sc.matches(/^[A-Z0-9_-]{1,12}$/) && newData.exists() && (!data.exists() ? (newData.child('uid').val() === auth.uid && newData.child('status').val() === 'active') : (data.child('status').val() === 'active' && newData.child('status').val() === 'resolved' && newData.child('uid').val() === data.child('uid').val() && newData.child('name').val() === data.child('name').val() && newData.child('role').val() === data.child('role').val() && newData.child('trigger').val() === data.child('trigger').val() && newData.child('beacon').val() === data.child('beacon').val() && newData.child('beaconRssi').val() === data.child('beaconRssi').val() && newData.child('ep').val() === data.child('ep').val() && newData.child('floor').val() === data.child('floor').val() && newData.child('proc').val() === data.child('proc').val() && (data.child('uid').val() === auth.uid || (newData.child('reason').val() === 'auto' && now >= data.child('createdAt').val() + 3600000))))",
            ".validate": "newData.hasChildren(['bleId','name','role','trigger','createdAt','status','uid'])",
            "bleId": {
              ".validate": "newData.isString() && newData.val().length <= 64 && (!data.exists() || newData.val() === data.val())"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "role": {
              ".validate": "newData.isString() && newData.val().length <= 32"
            },
            "trigger": {
              ".validate": "newData.val() === 'still' || newData.val() === 'fall'"
            },
            "beacon": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "beaconRssi": {
              ".validate": "newData.isNumber() && newData.val() >= -150 && newData.val() <= 20"
            },
            "createdAt": {
              ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === now : newData.val() === data.val())"
            },
            "status": {
              ".validate": "newData.val() === 'active' || newData.val() === 'resolved'"
            },
            "resolvedAt": {
              ".validate": "newData.isNumber() && newData.val() === now"
            },
            "uid": {
              ".validate": "newData.isString() && (!data.exists() ? newData.val() === auth.uid : newData.val() === data.val())"
            },
            "reason": {
              ".validate": "newData.val() === 'auto' && newData.parent().child('status').val() === 'resolved'"
            },
            "ep": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 255 && (!data.exists() || newData.val() === data.val())"
            },
            "floor": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{1,4}$/) && (!data.exists() || newData.val() === data.val())"
            },
            "proc": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{1,4}$/) && (!data.exists() || newData.val() === data.val())"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "hb": {
        "$sc": {
          ".indexOn": ["last"],
          "$sid": {
            ".write": "auth != null && $site.matches(/^[A-Za-z0-9_-]{1,32}$/) && $sc.matches(/^[A-Z0-9_-]{1,12}$/) && $sid.matches(/^[A-Za-z0-9_-]{1,40}$/) && newData.exists() && newData.child('uid').val() === auth.uid && (!data.exists() || (data.child('uid').val() === auth.uid && !data.child('end').exists()))",
            ".validate": "newData.hasChildren(['uid','role','start','last'])",
            "uid": {
              ".validate": "newData.isString() && newData.val() === auth.uid"
            },
            "role": {
              ".validate": "(newData.val() === 'WALKER' || newData.val() === 'EPJ' || newData.val() === 'FORKLIFT' || newData.val() === 'UNKNOWN') && (!data.exists() || newData.val() === data.val())"
            },
            "start": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000 && (!data.exists() || newData.val() === data.val())"
            },
            "last": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000"
            },
            "end": {
              ".validate": "newData.isNumber() && newData.val() <= now + 60000 && !data.exists()"
            },
            "floor": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{1,4}$/) && (!data.exists() || newData.val() === data.val())"
            },
            "proc": {
              ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{1,4}$/) && (!data.exists() || newData.val() === data.val())"
            },
            "g": {
              ".validate": "newData.hasChildren()",
              "$n": {
                ".validate": "$n.matches(/^([0-9]|[1-4][0-9])$/) && !data.exists() && newData.hasChildren(['from','to'])",
                "from": {
                  ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() < newData.parent().child('to').val()"
                },
                "to": {
                  ".validate": "newData.isNumber() && newData.val() <= now + 60000"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "echo_calib": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && $site.matches(/^[A-Za-z0-9_-]{1,32}$/)",
          ".validate": "newData.hasChildren(['model','ver','ts','peers','uid'])",
          "model": {
            ".validate": "newData.isString() && newData.val().length <= 64"
          },
          "ver": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "site": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "uid": {
            ".validate": "newData.isString() && newData.val() === auth.uid"
          },
          "peers": {
            "$peer": {
              ".validate": "newData.hasChildren(['m','n','iqr'])",
              "m": {
                ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 40"
              },
              "n": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30000"
              },
              "iqr": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "uwb_probe": {
        "$day": {
          "$probeId": {
            ".write": "auth != null && !data.exists() && $site.matches(/^[A-Za-z0-9_-]{1,32}$/) && $day.matches(/^[0-9]{8}$/)"
          }
        }
      }
    }
  }
}