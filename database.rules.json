{
  "rules": {
    ".read": false,
    ".write": false,

    "version": {
      ".read": true,
      ".write": false
    },

    "echo_calib": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null"
      }
    },

    "$site": {
      "version": {
        ".read": true,
        ".write": false
      },

      "alerts": {
        "$day": {
          "$alertId": {
            ".write": "auth != null && !data.exists()"
          }
        }
      },

      "beacon_share": {
        ".read": "auth != null",
        "$key": {
          ".write": "auth != null"
        }
      },

      "echo_calib": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null"
        }
      },

      "uwb_probe": {
        "$day": {
          "$probeId": {
            ".write": "auth != null && !data.exists()"
          }
        }
      }
    }
  }
}
