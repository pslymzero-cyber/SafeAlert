<?xml version="1.0" encoding="utf-8"?>
<!-- Dimension tokens — one set instead of scattered values.
       Spacing  7 (2 / 4 / 8 / 12 / 16 / 24 / 32)
       Radius   4 (4 / 12 / 18 / 24)
       Text     9 (10 / 11 / 12 / 13 / 14 / 15 / 17 / 22 / 26)
     When you touch a layout file, move its hard-coded dp/sp to these tokens. -->
<resources>

    <!-- ── Spacing ──────────────────────────────────────────────────────── -->
    <dimen name="sa_space_hairline">2dp</dimen>
    <dimen name="sa_space_xs">4dp</dimen>
    <dimen name="sa_space_sm">8dp</dimen>
    <dimen name="sa_space_md">12dp</dimen>
    <dimen name="sa_space_lg">16dp</dimen>
    <dimen name="sa_space_xl">24dp</dimen>
    <dimen name="sa_space_xxl">32dp</dimen>

    <!-- ── Corner radius ────────────────────────────────────────────────── -->
    <dimen name="sa_radius_xs">4dp</dimen>     <!-- label badges -->
    <dimen name="sa_radius_sm">12dp</dimen>    <!-- buttons, icon plates, small boxes -->
    <dimen name="sa_radius_md">18dp</dimen>    <!-- cards -->
    <dimen name="sa_radius_lg">24dp</dimen>    <!-- dialogs -->

    <!-- ── Strokes ──────────────────────────────────────────────────────── -->
    <dimen name="sa_stroke_hairline">1dp</dimen>
    <dimen name="sa_stroke_focus">1.5dp</dimen>

    <!-- ── Text size ────────────────────────────────────────────────────── -->
    <!-- Secondary metadata (MAC · UUID · license lines). Not for body text. -->
    <dimen name="sa_type_micro">10sp</dimen>
    <dimen name="sa_type_hint">11sp</dimen>
    <dimen name="sa_type_caption">12sp</dimen>
    <dimen name="sa_type_body">13sp</dimen>
    <dimen name="sa_type_value">14sp</dimen>
    <dimen name="sa_type_section">15sp</dimen>
    <dimen name="sa_type_topbar">17sp</dimen>
    <dimen name="sa_type_display">22sp</dimen>
    <!-- Running-card role label (tv_running_mode) only. Not used on settings screens. -->
    <dimen name="sa_type_metric">26sp</dimen>

    <!-- ── Fixed sizes ──────────────────────────────────────────────────── -->
    <!-- Minimum touch target. Assumes gloved hands — the floor for every tappable row/button. -->
    <dimen name="sa_touch_min">48dp</dimen>
    <dimen name="sa_topbar_height">56dp</dimen>
    <dimen name="sa_icon_sm">22dp</dimen>
    <!-- Icon badge container (shape_icon_bg_*). Not a tap target, so sa_touch_min does not apply. -->
    <dimen name="sa_icon_badge">44dp</dimen>
    <!-- Role icon (walker, equipment). One step larger than the badge so it reads first. -->
    <dimen name="sa_icon_role">46dp</dimen>
    <dimen name="sa_edit_number_width">96dp</dimen>

</resources>
