<resources>

    <!-- (v1.1.65) 앱 고정 다크. 부모가 Light.* 가 아니라는 점이 핵심 —
         시스템 다크 설정과 무관하게 항상 이 한 벌을 쓴다(values-night/ 없음).
         메인 화면은 원래부터 다크였고 설정 화면들만 라이트였다. 이제 앱 전체가 메인의 톤을 따른다. -->
    <style name="Theme.SafeAlert" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/sa_accent</item>
        <item name="colorPrimaryVariant">@color/sa_accent_dim</item>
        <item name="colorOnPrimary">@color/sa_on_accent</item>
        <item name="colorSecondary">@color/sa_accent_dim</item>
        <item name="colorSecondaryVariant">@color/sa_accent_dim</item>
        <item name="colorOnSecondary">@color/sa_on_accent</item>

        <item name="android:colorBackground">@color/sa_bg</item>
        <item name="colorOnBackground">@color/sa_text_primary</item>
        <item name="colorSurface">@color/sa_surface</item>
        <item name="colorOnSurface">@color/sa_text_primary</item>
        <item name="colorError">@color/sa_danger</item>
        <item name="colorOnError">@color/sa_on_accent</item>

        <item name="android:textColorPrimary">@color/sa_text_primary</item>
        <item name="android:textColorSecondary">@color/sa_text_secondary</item>
        <item name="android:textColorHint">@color/sa_text_tertiary</item>

        <!-- windowBackground 가 다크여야 화면 전환 순간 흰 판이 번쩍이지 않는다. -->
        <item name="android:windowBackground">@color/sa_bg</item>
        <item name="android:statusBarColor">@color/sa_bg</item>
        <item name="android:navigationBarColor">@color/sa_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- PIN 다이얼로그 키패드 버튼 -->
    <style name="PinButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">@dimen/sa_touch_min</item>
        <item name="android:textSize">@dimen/sa_type_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sa_text_primary</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- (v1.1.63) 설정 화면 공통 스타일 SA.* — BLE 감지 설정·개발자 설정 UI 통일 + 아코디언 섹션.
         SA = 공통 부모(빈 스타일).
         (v1.1.65) 색·치수를 전부 토큰 참조로 바꿨다. 여기서 값을 고치면 두 화면이 함께 따라온다. -->
    <style name="SA" />

    <style name="SA.TopBar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/sa_topbar_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/sa_space_lg</item>
        <item name="android:paddingEnd">@dimen/sa_space_sm</item>
        <item name="android:background">@color/sa_surface_alt</item>
    </style>
    <style name="SA.TopBarTitle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/sa_type_topbar</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sa_text_primary</item>
    </style>

    <!-- 아코디언 섹션 = 카드 1장: 헤더(탭=펼침/접힘 토글, 제목+요약값+셰브런) + 바디(기본 접힘) -->
    <style name="SA.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">@dimen/sa_space_md</item>
        <item name="cardCornerRadius">@dimen/sa_radius_md</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/sa_surface</item>
    </style>
    <style name="SA.SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/sa_space_lg</item>
        <item name="android:paddingEnd">@dimen/sa_space_md</item>
        <item name="android:paddingTop">@dimen/sa_space_lg</item>
        <item name="android:minHeight">@dimen/sa_touch_min</item>
        <item name="android:paddingBottom">@dimen/sa_space_lg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
    <style name="SA.SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/sa_type_section</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sa_text_primary</item>
    </style>
    <style name="SA.SectionSummary">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/sa_space_hairline</item>
        <item name="android:textSize">@dimen/sa_type_caption</item>
        <item name="android:textColor">@color/sa_text_tertiary</item>
    </style>
    <style name="SA.Chevron">
        <item name="android:layout_width">@dimen/sa_icon_sm</item>
        <item name="android:layout_height">@dimen/sa_icon_sm</item>
        <item name="android:layout_marginStart">@dimen/sa_space_sm</item>
        <item name="android:src">@drawable/ic_chevron_down</item>
    </style>
    <!-- 진입(오른쪽) 셰브런. 같은 벡터를 -90도 돌려 쓴다 — 아이콘을 하나만 유지하기 위함. -->
    <style name="SA.ChevronRight">
        <item name="android:layout_width">@dimen/sa_icon_sm</item>
        <item name="android:layout_height">@dimen/sa_icon_sm</item>
        <item name="android:layout_marginStart">@dimen/sa_space_sm</item>
        <item name="android:src">@drawable/ic_chevron_down</item>
        <item name="android:rotation">-90</item>
        <item name="android:tint">@color/sa_text_tertiary</item>
    </style>
    <style name="SA.SectionBody">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">@dimen/sa_space_lg</item>
        <item name="android:paddingEnd">@dimen/sa_space_lg</item>
        <item name="android:paddingBottom">@dimen/sa_space_lg</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="SA.Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginTop">@dimen/sa_space_md</item>
    </style>
    <style name="SA.RowLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/sa_type_body</item>
        <item name="android:textColor">@color/sa_text_secondary</item>
    </style>
    <style name="SA.Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/sa_type_body</item>
        <item name="android:textColor">@color/sa_text_secondary</item>
    </style>
    <style name="SA.SubHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/sa_space_md</item>
        <item name="android:textSize">@dimen/sa_type_body</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sa_text_secondary</item>
    </style>
    <style name="SA.Hint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/sa_space_xs</item>
        <item name="android:textSize">@dimen/sa_type_hint</item>
        <item name="android:textColor">@color/sa_text_tertiary</item>
    </style>
    <style name="SA.Value">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/sa_type_value</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/sa_accent</item>
    </style>
    <style name="SA.Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/sa_stroke_hairline</item>
        <item name="android:layout_marginTop">@dimen/sa_space_md</item>
        <item name="android:layout_marginBottom">@dimen/sa_space_hairline</item>
        <item name="android:background">@color/sa_divider</item>
    </style>
    <style name="SA.EditNumber">
        <item name="android:layout_width">@dimen/sa_edit_number_width</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/sa_touch_min</item>
        <item name="android:inputType">number</item>
        <item name="android:gravity">end</item>
        <item name="android:textSize">@dimen/sa_type_body</item>
        <item name="android:textColor">@color/sa_text_primary</item>
        <item name="android:textColorHint">@color/sa_text_tertiary</item>
    </style>
    <style name="SA.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/sa_touch_min</item>
        <item name="android:textSize">@dimen/sa_type_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/sa_on_accent</item>
        <item name="android:backgroundTint">@color/sa_accent</item>
        <item name="cornerRadius">@dimen/sa_radius_sm</item>
    </style>
    <style name="SA.Radio">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/sa_touch_min</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/sa_type_caption</item>
        <item name="android:textColor">@color/sa_text_secondary</item>
    </style>
    <style name="SA.Mono">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/sa_type_body</item>
        <item name="android:textColor">@color/sa_text_primary</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:lineSpacingExtra">@dimen/sa_space_xs</item>
    </style>

</resources>
