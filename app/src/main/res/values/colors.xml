<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed dark palette for the whole app.
     Values are the main screen's (activity_main.xml) dark colors, made into named tokens.
     No new colors — the main screen's tone is the whole app's tone.
     No values-night/: this one set is always used, regardless of the system dark setting.

     Contrast (WCAG, against card #1A2233):
       sa_text_primary   14.3:1   sa_text_secondary  9.7:1   sa_text_tertiary  5.5:1
       sa_accent          9.5:1   sa_danger          5.9:1   sa_warning       11.0:1   sa_safe  9.1:1 -->
<resources>

    <!-- ── Background · surface ─────────────────────────────────────────── -->
    <color name="sa_bg">#0B1220</color>            <!-- screen background -->
    <color name="sa_surface">#1A2233</color>       <!-- card -->
    <color name="sa_surface_alt">#161D2B</color>   <!-- secondary card, top bar -->
    <color name="sa_surface_veil">#E6141B2B</color><!-- translucent card over the background image -->
    <color name="sa_bar">#C20D1424</color>         <!-- main screen's translucent top/bottom bars -->
    <color name="sa_overlay">#E8101A2C</color>     <!-- faint plate (button tint etc.) -->
    <color name="sa_divider">#1FFFFFFF</color>     <!-- translucent white hairline -->
    <color name="sa_stroke">#56627A</color>        <!-- outline -->

    <!-- ── Text (3-step ramp) ───────────────────────────────────────────── -->
    <color name="sa_text_primary">#F1F5F9</color>   <!-- titles, body -->
    <color name="sa_text_secondary">#C3CDDC</color> <!-- labels -->
    <color name="sa_text_tertiary">#8B98AC</color>  <!-- summaries, hints, chevrons -->
    <color name="sa_on_accent">#0B1220</color>      <!-- text on accent backgrounds -->

    <!-- ── Accent ───────────────────────────────────────────────────────── -->
    <color name="sa_accent">#7DD3FC</color>       <!-- primary accent (values, buttons) -->
    <color name="sa_accent_dim">#60A5FA</color>   <!-- focus border, links -->
    <color name="sa_accent_soft">#8FB4E8</color>  <!-- input hints -->

    <!-- ── Status colors ────────────────────────────────────────────────── -->
    <color name="sa_safe">#4ADE80</color>
    <color name="sa_warning">#FCD34D</color>
    <color name="sa_warning_dim">#FBBF24</color>
    <color name="sa_danger">#FB7185</color>

    <!-- ── Badge / chip plates ──────────────────────── -->
    <!-- Dark inversions of the light pastel plates (#EFF6FF etc.).
         The main screen's icon plates (shape_icon_bg_*) reference these tokens too.
         The text carries the color; the plate only lays down a faint tint. -->
    <color name="sa_tint_blue">#17283F</color>
    <color name="sa_tint_amber">#33291A</color>
    <color name="sa_tint_rose">#3A1B24</color>
    <color name="sa_tint_green">#16301F</color>
    <color name="sa_tint_violet">#241B3D</color>
    <color name="sa_tint_cyan">#12303A</color>
    <color name="sa_tint_gray">#28303F</color>
    <color name="sa_tint_amber_stroke">#574518</color>   <!-- amber plate border -->

    <!-- Text on chip plates — the 3 colors sa_accent, sa_safe and sa_danger can't cover -->
    <color name="sa_orange">#FB923C</color>
    <color name="sa_violet">#C4B5FD</color>
    <color name="sa_cyan">#67E8F9</color>

    <!-- ── Neutral button (secondary action) ───────────────────────────── -->
    <color name="sa_button_neutral">#E2E8F0</color>   <!-- inverted button plate (Stop etc.) -->

    <!-- ── System ───────────────────────────────────────────────────────── -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

</resources>
