<?xml version="1.0" encoding="utf-8"?>
<!-- Background of a hazard-device row in the sidebar.
     The solid white is a placeholder for the runtime backgroundTintList multiply (same technique as shape_target_box).
     OverlayManager swaps the tint per alert level (sa_tint_rose / sa_tint_amber).
     ★ Never change this color — any other value darkens the tinted result. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#FFFFFFFF" />
    <corners android:radius="@dimen/sa_radius_sm" />
</shape>
