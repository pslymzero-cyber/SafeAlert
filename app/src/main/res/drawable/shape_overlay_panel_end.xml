<?xml version="1.0" encoding="utf-8"?>
<!--
  Sidebar panel plate — when docked to the right screen edge.
    The outer (right) corners stay square. A plate flush with the edge but with rounded outer corners
    leaves a gap at the screen edge and looks like a 'floating card'. Rounding only the inner side makes it an edge panel.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/sa_overlay" />
    <corners
        android:topLeftRadius="@dimen/sa_radius_md"
        android:bottomLeftRadius="@dimen/sa_radius_md"
        android:topRightRadius="0dp"
        android:bottomRightRadius="0dp" />
    <stroke
        android:width="@dimen/sa_stroke_hairline"
        android:color="@color/sa_stroke" />
</shape>
