<?xml version="1.0" encoding="utf-8"?>
<!-- Sidebar panel plate — when docked to the left screen edge. Only the inner (right) side is rounded. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/sa_overlay" />
    <corners
        android:topLeftRadius="0dp"
        android:bottomLeftRadius="0dp"
        android:topRightRadius="@dimen/sa_radius_md"
        android:bottomRightRadius="@dimen/sa_radius_md" />
    <stroke
        android:width="@dimen/sa_stroke_hairline"
        android:color="@color/sa_stroke" />
</shape>
