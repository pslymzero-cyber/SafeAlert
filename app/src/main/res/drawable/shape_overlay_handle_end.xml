<?xml version="1.0" encoding="utf-8"?>
<!--
  Thin handle for the collapsed state — when docked to the right screen edge.
    This bar (20dp wide) is all that normally stays on screen. Only the inner side is rounded.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/sa_overlay" />
    <corners
        android:topLeftRadius="@dimen/sa_radius_sm"
        android:bottomLeftRadius="@dimen/sa_radius_sm"
        android:topRightRadius="0dp"
        android:bottomRightRadius="0dp" />
    <stroke
        android:width="@dimen/sa_stroke_hairline"
        android:color="@color/sa_stroke" />
</shape>
