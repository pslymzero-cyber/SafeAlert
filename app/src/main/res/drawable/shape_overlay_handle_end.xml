<?xml version="1.0" encoding="utf-8"?>
<!--
  (v1.1.70) 접힘 상태의 얇은 핸들 — 화면 오른쪽 가장자리에 붙는 경우.
    평상시 화면에 남는 것은 이 막대뿐이다(폭 20dp). 안쪽만 둥글다.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/sa_overlay" />
    <corners
        android:topLeftRadius="@dimen/sa_radius_sm"
        android:bottomLeftRadius="@dimen/sa_radius_sm"
        android:topRightRadius="0dp"
        android:bottomRightRadius="0dp" />
    <stroke
        android:width="@dimen/sa_stroke_hairline"
        android:color="@color/sa_stroke" />
</shape>
