<?xml version="1.0" encoding="utf-8"?>
<!--
  Equipment picker popup, used instead of free-text entry of the display name.
  You only pick a type and a number; no keyboard. The point is that the screen offers no input
  through which a person's name could be entered.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/sa_surface"
    android:paddingStart="@dimen/sa_space_xl"
    android:paddingEnd="@dimen/sa_space_xl"
    android:paddingTop="@dimen/sa_space_lg"
    android:paddingBottom="@dimen/sa_space_sm">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="장비 종류"
        android:textSize="@dimen/sa_type_section"
        android:textColor="@color/sa_text_secondary" />

    <Spinner
        android:id="@+id/sp_pit_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sa_space_xs"
        android:background="@color/sa_surface_alt"
        android:popupBackground="@color/sa_surface"
        android:dropDownWidth="match_parent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sa_space_lg"
        android:text="장비 번호"
        android:textSize="@dimen/sa_type_section"
        android:textColor="@color/sa_text_secondary" />

    <Spinner
        android:id="@+id/sp_pit_no"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sa_space_xs"
        android:background="@color/sa_surface_alt"
        android:popupBackground="@color/sa_surface"
        android:dropDownWidth="match_parent" />

    <!-- Preview of the selection — shows both the value shown on other devices' screens and the value recorded in the alert log -->
    <TextView
        android:id="@+id/tv_pit_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sa_space_lg"
        android:paddingStart="@dimen/sa_space_md"
        android:paddingEnd="@dimen/sa_space_md"
        android:paddingTop="@dimen/sa_space_sm"
        android:paddingBottom="@dimen/sa_space_sm"
        android:background="@color/sa_surface_alt"
        android:textSize="@dimen/sa_type_value"
        android:textColor="@color/sa_text_secondary" />

</LinearLayout>
