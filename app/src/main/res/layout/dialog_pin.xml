<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/sa_space_xxl"
    android:paddingEnd="@dimen/sa_space_xxl"
    android:paddingTop="36dp"
    android:paddingBottom="28dp"
    android:background="@drawable/shape_dialog_bg">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="개발자 설정"
        android:textSize="@dimen/sa_type_display"
        android:textStyle="bold"
        android:textColor="@color/sa_text_primary" />

    <TextView
        android:id="@+id/tv_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="PIN을 입력하세요"
        android:textSize="@dimen/sa_type_value"
        android:textColor="@color/sa_text_tertiary" />

    <!-- Step line (first-set / change modes only) -->
    <TextView
        android:id="@+id/tv_steps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textSize="13sp"
        android:textColor="@color/sa_text_tertiary"
        android:visibility="gone" />

    <!-- 10 PIN dots, grouped 3-4-3 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/sa_space_xxl"
        android:layout_marginBottom="@dimen/sa_space_md"
        android:orientation="horizontal">
        <View android:id="@+id/dot1" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="8dp" android:background="@drawable/shape_pin_dot_empty"/>
        <View android:id="@+id/dot2" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="8dp" android:background="@drawable/shape_pin_dot_empty"/>
        <View android:id="@+id/dot3" android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/shape_pin_dot_empty"/>
        <View android:id="@+id/dot4" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="18dp" android:layout_marginEnd="8dp" android:background="@drawable/shape_pin_dot_empty"/>
        <View android:id="@+id/dot5" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="8dp" android:background="@drawable/shape_pin_dot_empty"/>
        <View android:id="@+id/dot6" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="8dp" android:background="@drawable/shape_pin_dot_empty"/>
        <View android:id="@+id/dot7" android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/shape_pin_dot_empty"/>
        <View android:id="@+id/dot8" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="18dp" android:layout_marginEnd="8dp" android:background="@drawable/shape_pin_dot_empty"/>
        <View android:id="@+id/dot9" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginEnd="8dp" android:background="@drawable/shape_pin_dot_empty"/>
        <View android:id="@+id/dot10" android:layout_width="14dp" android:layout_height="14dp" android:background="@drawable/shape_pin_dot_empty"/>
    </LinearLayout>

    <!-- Error message -->
    <TextView
        android:id="@+id/tv_error"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/sa_space_md"
        android:text="PIN이 올바르지 않습니다"
        android:textSize="@dimen/sa_type_body"
        android:textColor="@color/sa_danger"
        android:visibility="invisible" />

    <!-- Number pad -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal">
        <TextView android:id="@+id/btn1" style="@style/PinButton" android:text="1"/>
        <TextView android:id="@+id/btn2" style="@style/PinButton" android:text="2"/>
        <TextView android:id="@+id/btn3" style="@style/PinButton" android:text="3"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal">
        <TextView android:id="@+id/btn4" style="@style/PinButton" android:text="4"/>
        <TextView android:id="@+id/btn5" style="@style/PinButton" android:text="5"/>
        <TextView android:id="@+id/btn6" style="@style/PinButton" android:text="6"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal">
        <TextView android:id="@+id/btn7" style="@style/PinButton" android:text="7"/>
        <TextView android:id="@+id/btn8" style="@style/PinButton" android:text="8"/>
        <TextView android:id="@+id/btn9" style="@style/PinButton" android:text="9"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:orientation="horizontal">
        <Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
        <TextView android:id="@+id/btn0" style="@style/PinButton" android:text="0"/>
        <TextView android:id="@+id/btn_back" style="@style/PinButton" android:drawableStart="@drawable/ic_backspace" android:drawableTint="@color/sa_text_primary" android:contentDescription="지우기"/>
    </LinearLayout>

    <!-- Forgot link (shown only when the caller supplies a handler) -->
    <TextView
        android:id="@+id/tv_forgot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:minHeight="48dp"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="PIN을 모르시나요?"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/sa_accent"
        android:visibility="gone" />

</LinearLayout>
