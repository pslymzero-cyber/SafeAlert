<?xml version="1.0" encoding="utf-8"?>
<!-- [v1.0.50 #2] 다크 리워크 — 역할별 배경 사진 + 반투명 다크 카드 (기존 뷰 ID 전부 유지, 기능 불변) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sa_bg">

    <!-- 역할별 배경 사진 (실행 화면 전용 — showRunningUi 가 역할에 맞춰 표시/전환) -->
    <ImageView
        android:id="@+id/iv_role_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- 사진 위 어두운 스크림 (가독성 확보) -->
    <View
        android:id="@+id/view_bg_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_bg_scrim"
        android:visibility="gone" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- 상단 바 (액션바 없이 자체 구성) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/sa_bar">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/shape_dot_green"
            android:layout_marginEnd="@dimen/sa_space_sm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SafeAlert"
            android:textSize="@dimen/sa_type_display"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="@color/sa_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/sa_stroke_hairline"
        android:background="@color/sa_divider" />

    <!-- 스크롤 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="@dimen/sa_space_lg"
            android:paddingBottom="@dimen/sa_space_lg">

            <!-- ── 실행 중 카드 (반투명 다크) ── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_running"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="@dimen/sa_radius_lg"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/sa_surface_veil"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 상태 + 시작 시각 (한 줄) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="7dp" android:layout_height="7dp"
                            android:background="@drawable/shape_dot_green"
                            android:layout_marginEnd="@dimen/sa_space_sm"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="백그라운드 실행 중"
                            android:textSize="@dimen/sa_type_hint" android:textColor="@color/sa_safe"/>
                        <TextView
                            android:id="@+id/tv_running_since"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="@dimen/sa_type_hint" android:textColor="@color/sa_text_tertiary"/>
                    </LinearLayout>

                    <!-- ══ 내 장비 (Local) 섹션 — 내가 송출하는 역할/상태/속도 (수신 데이터와 분리) ══ -->
                    <TextView
                        android:id="@+id/tv_local_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sa_space_md"
                        android:text="내 장비 (Local)" android:drawableStart="@drawable/shape_bullet_square" android:drawableTint="@color/sa_accent_dim" android:drawablePadding="@dimen/sa_space_xs"
                        android:textSize="@dimen/sa_type_caption" android:textStyle="bold"
                        android:textColor="@color/sa_accent_dim"/>

                    <!-- 이름 / ID (별도 줄, 굵게) -->
                    <TextView
                        android:id="@+id/tv_running_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sa_space_xs"
                        android:textSize="@dimen/sa_type_display"
                        android:textStyle="bold"
                        android:textColor="@color/sa_text_primary"/>

                    <!-- 역할 아이콘 + 모드 + TEST 버튼 (한 줄) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_role_icon"
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:layout_marginEnd="@dimen/sa_space_md"
                            android:src="@drawable/ic_walker"
                            android:contentDescription="@null"/>

                        <!-- 모드 (내 역할) -->
                        <TextView
                            android:id="@+id/tv_running_mode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="@dimen/sa_type_metric"
                            android:textStyle="bold"
                            android:textColor="@color/sa_text_primary"/>

                        <!-- 테스트 경보 버튼 (우측 소형 — 종 아이콘 + TEST) -->
                        <Button
                            android:id="@+id/btn_test_alert"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="62dp"
                            android:layout_height="62dp"
                            android:layout_marginStart="@dimen/sa_space_sm"
                            android:insetTop="0dp" android:insetBottom="0dp"
                            android:paddingStart="0dp" android:paddingEnd="0dp"
                            android:paddingTop="11dp" android:paddingBottom="9dp"
                            android:text="TEST" android:textSize="@dimen/sa_type_micro"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:textColor="@color/sa_text_secondary"
                            android:drawableTop="@drawable/ic_bell"
                            android:drawableTint="@color/sa_text_secondary"
                            android:drawablePadding="@dimen/sa_space_hairline"
                            android:stateListAnimator="@null"
                            app:strokeColor="@color/sa_stroke"
                            app:strokeWidth="@dimen/sa_stroke_hairline"
                            app:cornerRadius="14dp"/>
                    </LinearLayout>

                    <!-- [v1.0.42 Req2] 내 장비 상태/속도 — localSnapshot 에서만 갱신(수신 데이터 영향 X) -->
                    <TextView
                        android:id="@+id/tv_local_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/shape_local_state_box"
                        android:padding="10dp"
                        android:text="상태: 정지·일반 · 속도: 0 km/h"
                        android:textSize="@dimen/sa_type_body" android:textStyle="bold"
                        android:textColor="@color/sa_accent_soft"
                        android:fontFamily="monospace"/>

                    <!-- ══ 수신 타겟 (Target) 섹션 — 상대 기기 수신 데이터 전용 (내 장비와 분리) ══ -->
                    <TextView
                        android:id="@+id/tv_target_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sa_space_lg"
                        android:text="수신 타겟 (Target)" android:drawableStart="@drawable/shape_bullet_square" android:drawableTint="@color/sa_danger" android:drawablePadding="@dimen/sa_space_xs"
                        android:textSize="@dimen/sa_type_caption" android:textStyle="bold"
                        android:textColor="@color/sa_danger"/>

                    <!-- 감지 신호 목록 placeholder (목록이 비었을 때만 표시) -->
                    <TextView
                        android:id="@+id/tv_approaching"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:padding="14dp"
                        android:textSize="@dimen/sa_type_value"
                        android:textColor="@color/sa_text_primary"
                        android:gravity="start"
                        android:lineSpacingMultiplier="1.4"
                        android:fontFamily="monospace"/>

                    <!-- 감지 기기 목록 / BLE 상태 (수신 타겟 상세 readout — detectedSnapshot 에서만 갱신)
                         배경색은 코드가 경보 레벨별로 backgroundTint 갱신 (shape 둥근 모서리 유지) -->
                    <TextView
                        android:id="@+id/tv_ble_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sa_space_xs"
                        android:text="서비스 시작 중..."
                        android:textSize="@dimen/sa_type_body" android:textColor="@color/sa_text_tertiary"
                        android:background="@drawable/shape_target_box"
                        android:backgroundTint="@color/sa_overlay"
                        android:padding="@dimen/sa_space_md"
                        android:lineSpacingMultiplier="1.3"
                        android:fontFamily="monospace"/>

                    <!-- 무음 인디케이터 -->
                    <TextView
                        android:id="@+id/tv_muted_indicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/shape_muted_box"
                        android:padding="10dp"
                        android:gravity="center_vertical"
                        android:text="일시 무음 중  —  탭하여 즉시 재개"
                        android:drawableStart="@drawable/ic_mute"
                        android:drawableTint="@color/sa_warning"
                        android:drawablePadding="@dimen/sa_space_sm"
                        android:textSize="@dimen/sa_type_body" android:textStyle="bold"
                        android:textColor="@color/sa_warning"
                        android:clickable="true" android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:visibility="gone"/>

                    <!-- [v1.1.60] 역할 전환 버튼 — 확인 다이얼로그 후 정지→반대 역할 재시작 -->
                    <Button
                        android:id="@+id/btn_switch_role"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:layout_marginTop="@dimen/sa_space_lg"
                        android:text="역할 전환" android:textSize="@dimen/sa_type_section"
                        android:textStyle="bold"
                        android:textColor="@color/sa_bg" android:backgroundTint="@color/sa_accent"
                        android:stateListAnimator="@null"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        app:cornerRadius="26dp"/>

                    <!-- 중지 버튼 (밝은 회백 필 버튼) -->
                    <Button
                        android:id="@+id/btn_stop"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:layout_marginTop="@dimen/sa_space_lg"
                        android:text="중지" android:textSize="@dimen/sa_type_section"
                        android:textStyle="bold"
                        android:textColor="@color/sa_on_accent" android:backgroundTint="@color/sa_button_neutral"
                        android:stateListAnimator="@null"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        app:cornerRadius="26dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── 모드 선택 ── -->
            <LinearLayout
                android:id="@+id/layout_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 모드 선택 타이틀 + 설명 한 줄 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="모드 선택"
                        android:textSize="@dimen/sa_type_topbar"
                        android:textStyle="bold"
                        android:textColor="@color/sa_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sa_space_sm"
                        android:text="· 역할에 맞는 모드를 선택하세요"
                        android:textSize="@dimen/sa_type_caption"
                        android:textColor="@color/sa_text_tertiary" />

                </LinearLayout>

                <!-- 이름 입력 (선택) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:hint="이름 또는 직번 (선택, 예: 홍길동)"
                    android:textColorHint="@color/sa_text_tertiary"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="@dimen/sa_radius_sm" app:boxCornerRadiusTopEnd="@dimen/sa_radius_sm"
                    app:boxCornerRadiusBottomStart="@dimen/sa_radius_sm" app:boxCornerRadiusBottomEnd="@dimen/sa_radius_sm"
                    app:boxStrokeColor="@color/box_stroke_dark" app:hintTextColor="@color/sa_accent_soft">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_display_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textSize="@dimen/sa_type_section"
                        android:textColor="@color/sa_text_primary"
                        android:imeOptions="actionDone"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- [v1.0.34] 보행자 역할 카드 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_role_walker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/sa_radius_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/sa_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/sa_space_lg"
                        android:paddingVertical="@dimen/sa_space_md"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:gravity="center"
                            android:background="@drawable/shape_icon_bg_green"
                            android:layout_marginEnd="14dp">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_walker"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="보행자"
                                android:textSize="@dimen/sa_type_section"
                                android:textStyle="bold"
                                android:textColor="@color/sa_text_primary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sa_space_hairline"
                                android:text="도보 이동 작업자"
                                android:textSize="@dimen/sa_type_caption"
                                android:textColor="@color/sa_text_tertiary" />
                        </LinearLayout>

                        <ImageView
                            style="@style/SA.ChevronRight"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- [v1.0.34] EPJ(전동 파레트 잭) 역할 카드
                     [v1.1.60] 오더십 리뷰로 비하인드(gone) — 수신·판정·핸들러 코드는 전부 보존.
                     부활 시 이 visibility 한 줄만 제거 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_role_epj"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sa_space_sm"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/sa_radius_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/sa_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/sa_space_lg"
                        android:paddingVertical="@dimen/sa_space_md"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:gravity="center"
                            android:background="@drawable/shape_icon_bg_gray"
                            android:layout_marginEnd="14dp">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_epj"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EPJ"
                                android:textSize="@dimen/sa_type_section"
                                android:textStyle="bold"
                                android:textColor="@color/sa_text_primary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sa_space_hairline"
                                android:text="전동 파레트 잭 운전자"
                                android:textSize="@dimen/sa_type_caption"
                                android:textColor="@color/sa_text_tertiary" />
                        </LinearLayout>

                        <ImageView
                            style="@style/SA.ChevronRight"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- [v1.0.34] 지게차 역할 카드 -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_role_forklift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sa_space_sm"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/sa_radius_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/sa_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/sa_space_lg"
                        android:paddingVertical="@dimen/sa_space_md"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:gravity="center"
                            android:background="@drawable/shape_icon_bg_blue"
                            android:layout_marginEnd="14dp">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_forklift"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="지게차"
                                android:textSize="@dimen/sa_type_section"
                                android:textStyle="bold"
                                android:textColor="@color/sa_text_primary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sa_space_hairline"
                                android:text="지게차·리치 운전자"
                                android:textSize="@dimen/sa_type_caption"
                                android:textColor="@color/sa_text_tertiary" />
                        </LinearLayout>

                        <ImageView
                            style="@style/SA.ChevronRight"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- 비콘 관리 카드 (보행자 아래) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_beacon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sa_space_sm"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/sa_radius_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/sa_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/sa_space_lg"
                        android:paddingVertical="@dimen/sa_space_md"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:gravity="center"
                            android:background="@drawable/shape_icon_bg_gray"
                            android:layout_marginEnd="14dp">
                            <ImageView
                                android:layout_width="@dimen/sa_icon_sm"
                                android:layout_height="@dimen/sa_icon_sm"
                                android:src="@drawable/ic_antenna"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="비콘 관리"
                                android:textSize="@dimen/sa_type_section"
                                android:textStyle="bold"
                                android:textColor="@color/sa_text_primary" />
                            <TextView
                                android:id="@+id/tv_beacon_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sa_space_hairline"
                                android:text="iOS·앱 없는 보행자 감지 설정"
                                android:textSize="@dimen/sa_type_caption"
                                android:textColor="@color/sa_text_tertiary" />
                        </LinearLayout>

                        <ImageView
                            style="@style/SA.ChevronRight"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- BLE 설정 카드 (비콘 아래) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_ble_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sa_space_sm"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    app:cardCornerRadius="@dimen/sa_radius_md" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/sa_surface">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:paddingHorizontal="@dimen/sa_space_lg"
                        android:paddingVertical="@dimen/sa_space_md" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                            android:gravity="center" android:background="@drawable/shape_icon_bg_blue"
                            android:layout_marginEnd="14dp">
                            <ImageView
                                android:layout_width="@dimen/sa_icon_sm"
                                android:layout_height="@dimen/sa_icon_sm"
                                android:src="@drawable/ic_signal_bars"
                                android:contentDescription="@null"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="BLE 설정" android:textSize="@dimen/sa_type_section"
                                android:textStyle="bold" android:textColor="@color/sa_text_primary"/>
                            <TextView android:id="@+id/tv_ble_mode_summary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sa_space_hairline" android:textSize="@dimen/sa_type_caption" android:textColor="@color/sa_text_tertiary"/>
                        </LinearLayout>
                        <ImageView
                            style="@style/SA.ChevronRight"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Settings 카드 (PIN 전용) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sa_space_sm"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/sa_radius_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/sa_surface_alt">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/sa_space_lg"
                        android:paddingVertical="@dimen/sa_space_md"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:gravity="center"
                            android:background="@drawable/shape_icon_bg_gray"
                            android:layout_marginEnd="14dp">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@android:drawable/ic_menu_preferences"
                                android:contentDescription="Settings"
                                android:tint="@color/sa_text_tertiary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="개발자 설정"
                                android:textSize="@dimen/sa_type_section"
                                android:textStyle="bold"
                                android:textColor="@color/sa_text_secondary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sa_space_hairline"
                                android:text="PIN 입력 필요"
                                android:textSize="@dimen/sa_type_caption"
                                android:textColor="@color/sa_text_tertiary" />
                        </LinearLayout>

                        <ImageView
                            style="@style/SA.ChevronRight"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- 권한 경고 -->
            <LinearLayout
                android:id="@+id/layout_permission_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/shape_warning_bg"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_permission_msg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/sa_type_caption"
                    android:textColor="@color/sa_warning" />

                <TextView
                    android:id="@+id/btn_grant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sa_space_sm"
                    android:text="허용"
                    android:textSize="@dimen/sa_type_caption"
                    android:textStyle="bold"
                    android:textColor="@color/sa_warning_dim"
                    android:padding="@dimen/sa_space_xs"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 하단 고정: 버전 + 크레딧 (코드에서 BuildConfig.VERSION_NAME으로 동적 설정) -->
    <TextView
        android:id="@+id/tv_version_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:gravity="center"
        android:text="v1.0.0  ·  Created by Ian"
        android:textSize="@dimen/sa_type_hint"
        android:textColor="@color/sa_text_tertiary"
        android:letterSpacing="0.05"
        android:background="@color/sa_bar" />

</LinearLayout>

    <!-- [v1.1.1] 시작 스플래시 — 1.5초 표시 후 MainActivity 가 페이드아웃. clickable 로 하단 UI
         터치 차단, 화면 재생성(회전 등) 시에는 onCreate 가 즉시 숨김 -->
    <ImageView
        android:id="@+id/iv_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash"
        android:background="@color/sa_bg"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@null" />

</FrameLayout>
