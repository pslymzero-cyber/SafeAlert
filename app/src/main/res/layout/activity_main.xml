<?xml version="1.0" encoding="utf-8"?>
<!-- Dark layout — role-specific background photo + translucent dark cards -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sa_bg">

    <!-- Background photo — the warehouse view (bg_main) on the selection screen; showRunningUi
         (via applyRoleVisuals) switches it to the role's photo while running -->
    <ImageView
        android:id="@+id/iv_role_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- Dark scrim over the photo (for readability) -->
    <View
        android:id="@+id/view_bg_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_bg_scrim"
        android:visibility="gone" />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- Top bar (built in the layout; no action bar) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/sa_bar">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/shape_dot_green"
            android:layout_marginEnd="@dimen/sa_space_sm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SafeAlert"
            android:textSize="@dimen/sa_type_display"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:textColor="@color/sa_text_primary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/sa_stroke_hairline"
        android:background="@color/sa_divider" />

    <!-- Scroll -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="@dimen/sa_space_lg"
            android:paddingBottom="@dimen/sa_space_lg">

            <!-- ── Running card (translucent dark) ── -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_running"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="@dimen/sa_radius_lg"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/sa_surface_veil"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Status + start time (one line) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <View
                            android:layout_width="7dp" android:layout_height="7dp"
                            android:background="@drawable/shape_dot_green"
                            android:layout_marginEnd="@dimen/sa_space_sm"/>
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="백그라운드 실행 중"
                            android:textSize="@dimen/sa_type_hint" android:textColor="@color/sa_safe"/>
                        <TextView
                            android:id="@+id/tv_running_since"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="@dimen/sa_type_hint" android:textColor="@color/sa_text_tertiary"/>
                    </LinearLayout>

                    <!-- ══ "내 장비 (Local)" section — the role/state/speed this device advertises (kept apart from received data) ══ -->
                    <TextView
                        android:id="@+id/tv_local_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sa_space_md"
                        android:text="내 장비 (Local)" android:drawableStart="@drawable/shape_bullet_square" android:drawableTint="@color/sa_accent_dim" android:drawablePadding="@dimen/sa_space_xs"
                        android:textSize="@dimen/sa_type_caption" android:textStyle="bold"
                        android:textColor="@color/sa_accent_dim"/>

                    <!-- Name / ID (separate line, bold) -->
                    <TextView
                        android:id="@+id/tv_running_id"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sa_space_xs"
                        android:textSize="@dimen/sa_type_display"
                        android:textStyle="bold"
                        android:textColor="@color/sa_text_primary"/>

                    <!-- Role icon + mode + TEST button (one line) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/iv_role_icon"
                            android:layout_width="@dimen/sa_icon_role"
                            android:layout_height="@dimen/sa_icon_role"
                            android:layout_marginEnd="@dimen/sa_space_md"
                            android:src="@drawable/ic_walker"
                            android:contentDescription="@null"/>

                        <!-- Mode (my role) -->
                        <TextView
                            android:id="@+id/tv_running_mode"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="@dimen/sa_type_metric"
                            android:textStyle="bold"
                            android:textColor="@color/sa_text_primary"/>

                        <!-- Test alert button (small, on the right — bell icon + TEST) -->
                        <Button
                            android:id="@+id/btn_test_alert"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="62dp"
                            android:layout_height="62dp"
                            android:layout_marginStart="@dimen/sa_space_sm"
                            android:insetTop="0dp" android:insetBottom="0dp"
                            android:paddingStart="0dp" android:paddingEnd="0dp"
                            android:paddingTop="11dp" android:paddingBottom="9dp"
                            android:text="TEST" android:textSize="@dimen/sa_type_micro"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"
                            android:textColor="@color/sa_text_secondary"
                            android:drawableTop="@drawable/ic_bell"
                            android:drawableTint="@color/sa_text_secondary"
                            android:drawablePadding="@dimen/sa_space_hairline"
                            android:stateListAnimator="@null"
                            app:strokeColor="@color/sa_stroke"
                            app:strokeWidth="@dimen/sa_stroke_hairline"
                            app:cornerRadius="14dp"/>
                    </LinearLayout>

                    <!-- My equipment state/speed — updated only from localSnapshot (received data has no effect) -->
                    <TextView
                        android:id="@+id/tv_local_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/shape_local_state_box"
                        android:padding="10dp"
                        android:text="상태: 정지·일반 · 속도: 0 km/h"
                        android:textSize="@dimen/sa_type_body" android:textStyle="bold"
                        android:textColor="@color/sa_accent_soft"
                        android:fontFamily="monospace"/>

                    <!-- ══ "수신 타겟 (Target)" section — received data from other devices only (kept apart from my equipment) ══ -->
                    <TextView
                        android:id="@+id/tv_target_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sa_space_lg"
                        android:text="수신 타겟 (Target)" android:drawableStart="@drawable/shape_bullet_square" android:drawableTint="@color/sa_danger" android:drawablePadding="@dimen/sa_space_xs"
                        android:textSize="@dimen/sa_type_caption" android:textStyle="bold"
                        android:textColor="@color/sa_danger"/>

                    <!-- Detected-signal list placeholder (shown only when the list is empty) -->
                    <TextView
                        android:id="@+id/tv_approaching"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:padding="14dp"
                        android:textSize="@dimen/sa_type_value"
                        android:textColor="@color/sa_text_primary"
                        android:gravity="start"
                        android:lineSpacingMultiplier="1.4"
                        android:fontFamily="monospace"/>

                    <!-- Detected-device list / BLE status (detailed readout of received targets — updated only from detectedSnapshot)
                         The code sets the background per alert level via backgroundTint (keeps the shape's rounded corners) -->
                    <TextView
                        android:id="@+id/tv_ble_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sa_space_xs"
                        android:text="서비스 시작 중..."
                        android:textSize="@dimen/sa_type_body" android:textColor="@color/sa_text_tertiary"
                        android:background="@drawable/shape_target_box"
                        android:backgroundTint="@color/sa_overlay"
                        android:padding="@dimen/sa_space_md"
                        android:lineSpacingMultiplier="1.3"
                        android:fontFamily="monospace"/>

                    <!-- Mute indicator -->
                    <TextView
                        android:id="@+id/tv_muted_indicator"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/shape_muted_box"
                        android:padding="10dp"
                        android:gravity="center_vertical"
                        android:text="일시 무음 중  —  탭하여 즉시 재개"
                        android:drawableStart="@drawable/ic_mute"
                        android:drawableTint="@color/sa_warning"
                        android:drawablePadding="@dimen/sa_space_sm"
                        android:textSize="@dimen/sa_type_body" android:textStyle="bold"
                        android:textColor="@color/sa_warning"
                        android:clickable="true" android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:visibility="gone"/>

                    <!-- Lone-worker notice line (LoneWorkerMonitor.banner): the no-movement watch is paused while charging (PDA
                         cradle) or until the first movement, or there is no accelerometer. Gone when there is no notice. -->
                    <TextView
                        android:id="@+id/tv_lw_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/sa_space_xs"
                        android:textSize="@dimen/sa_type_body"
                        android:textColor="@color/sa_text_tertiary"
                        android:visibility="gone"/>

                    <!-- Role switch button — after a confirmation dialog, stops and restarts in the opposite role -->
                    <Button
                        android:id="@+id/btn_switch_role"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:layout_marginTop="@dimen/sa_space_lg"
                        android:text="역할 전환" android:textSize="@dimen/sa_type_section"
                        android:textStyle="bold"
                        android:textColor="@color/sa_bg" android:backgroundTint="@color/sa_accent"
                        android:stateListAnimator="@null"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        app:cornerRadius="26dp"/>

                    <!-- Stop button (light gray-white filled button) -->
                    <Button
                        android:id="@+id/btn_stop"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:layout_marginTop="@dimen/sa_space_lg"
                        android:text="중지" android:textSize="@dimen/sa_type_section"
                        android:textStyle="bold"
                        android:textColor="@color/sa_on_accent" android:backgroundTint="@color/sa_button_neutral"
                        android:stateListAnimator="@null"
                        style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                        app:cornerRadius="26dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ── Mode selection ── -->
            <LinearLayout
                android:id="@+id/layout_select"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Mode selection title + one-line description -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="모드 선택"
                        android:textSize="@dimen/sa_type_topbar"
                        android:textStyle="bold"
                        android:textColor="@color/sa_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sa_space_sm"
                        android:text="· 역할에 맞는 모드를 선택하세요"
                        android:textSize="@dimen/sa_type_caption"
                        android:textColor="@color/sa_text_tertiary" />

                </LinearLayout>

                <!-- Name (optional) + site code (required), side by side -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <!-- Equipment selection only — no typing. Tapping opens the type/number picker popup -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_display_name"
                        android:layout_width="0dp"
                        android:layout_weight="1.7"
                        android:layout_height="wrap_content"
                        android:hint="내 장비 (탭하여 선택)"
                        android:textColorHint="@color/sa_text_tertiary"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:helperTextEnabled="true"
                        app:boxCornerRadiusTopStart="@dimen/sa_radius_sm" app:boxCornerRadiusTopEnd="@dimen/sa_radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/sa_radius_sm" app:boxCornerRadiusBottomEnd="@dimen/sa_radius_sm"
                        app:boxStrokeColor="@color/box_stroke_dark" app:hintTextColor="@color/sa_accent_soft">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_display_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:focusable="false"
                            android:cursorVisible="false"
                            android:textSize="@dimen/sa_type_section"
                            android:textColor="@color/sa_text_primary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Site code — case-insensitive (normalized to uppercase). The key that keeps alert and calibration data separate -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/sa_space_sm"
                        android:id="@+id/til_site_code"
                        android:hint="센터명"
                        android:textColorHint="@color/sa_text_tertiary"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="@dimen/sa_radius_sm" app:boxCornerRadiusTopEnd="@dimen/sa_radius_sm"
                        app:boxCornerRadiusBottomStart="@dimen/sa_radius_sm" app:boxCornerRadiusBottomEnd="@dimen/sa_radius_sm"
                        app:boxStrokeColor="@color/box_stroke_dark" app:hintTextColor="@color/sa_accent_soft">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_site_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapCharacters"
                            android:maxLength="12"
                            android:textSize="@dimen/sa_type_section"
                            android:textColor="@color/sa_text_primary"
                            android:imeOptions="actionDone"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Walker role card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_role_walker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/sa_radius_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/sa_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/sa_space_lg"
                        android:paddingVertical="@dimen/sa_space_md"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="@dimen/sa_icon_badge"
                            android:layout_height="@dimen/sa_icon_badge"
                            android:gravity="center"
                            android:background="@drawable/shape_icon_bg_green"
                            android:layout_marginEnd="14dp">
                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:src="@drawable/ic_walker"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="보행자"
                                android:textSize="@dimen/sa_type_section"
                                android:textStyle="bold"
                                android:textColor="@color/sa_text_primary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sa_space_hairline"
                                android:text="도보 이동 작업자"
                                android:textSize="@dimen/sa_type_caption"
                                android:textColor="@color/sa_text_tertiary" />
                        </LinearLayout>

                        <ImageView
                            style="@style/SA.ChevronRight"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Equipment operator role card ("장비 작업자": forklift, reach truck, EPJ, etc.; the chosen equipment sets the role) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_role_forklift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sa_space_sm"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/sa_radius_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/sa_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/sa_space_lg"
                        android:paddingVertical="@dimen/sa_space_md"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="@dimen/sa_icon_badge"
                            android:layout_height="@dimen/sa_icon_badge"
                            android:gravity="center"
                            android:background="@drawable/shape_icon_bg_blue"
                            android:layout_marginEnd="14dp">
                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_forklift"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="장비 작업자"
                                android:textSize="@dimen/sa_type_section"
                                android:textStyle="bold"
                                android:textColor="@color/sa_text_primary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sa_space_hairline"
                                android:text="지게차·리치·EPJ 등 장비 운전자"
                                android:textSize="@dimen/sa_type_caption"
                                android:textColor="@color/sa_text_tertiary" />
                        </LinearLayout>

                        <ImageView
                            style="@style/SA.ChevronRight"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Beacon management card (below the equipment card) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_beacon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sa_space_sm"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/sa_radius_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/sa_surface">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/sa_space_lg"
                        android:paddingVertical="@dimen/sa_space_md"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="@dimen/sa_icon_badge"
                            android:layout_height="@dimen/sa_icon_badge"
                            android:gravity="center"
                            android:background="@drawable/shape_icon_bg_gray"
                            android:layout_marginEnd="14dp">
                            <ImageView
                                android:layout_width="@dimen/sa_icon_sm"
                                android:layout_height="@dimen/sa_icon_sm"
                                android:src="@drawable/ic_antenna"
                                android:contentDescription="@null" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="비콘 관리"
                                android:textSize="@dimen/sa_type_section"
                                android:textStyle="bold"
                                android:textColor="@color/sa_text_primary" />
                            <TextView
                                android:id="@+id/tv_beacon_summary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sa_space_hairline"
                                android:text="iOS·앱 없는 보행자 감지 설정"
                                android:textSize="@dimen/sa_type_caption"
                                android:textColor="@color/sa_text_tertiary" />
                        </LinearLayout>

                        <ImageView
                            style="@style/SA.ChevronRight"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- BLE settings card (below the beacon card) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_ble_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sa_space_sm"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true" android:focusable="true"
                    app:cardCornerRadius="@dimen/sa_radius_md" app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/sa_surface">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:paddingHorizontal="@dimen/sa_space_lg"
                        android:paddingVertical="@dimen/sa_space_md" android:gravity="center_vertical">
                        <LinearLayout android:layout_width="@dimen/sa_icon_badge" android:layout_height="@dimen/sa_icon_badge"
                            android:gravity="center" android:background="@drawable/shape_icon_bg_blue"
                            android:layout_marginEnd="14dp">
                            <ImageView
                                android:layout_width="@dimen/sa_icon_sm"
                                android:layout_height="@dimen/sa_icon_sm"
                                android:src="@drawable/ic_signal_bars"
                                android:contentDescription="@null"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="BLE 설정" android:textSize="@dimen/sa_type_section"
                                android:textStyle="bold" android:textColor="@color/sa_text_primary"/>
                            <TextView android:id="@+id/tv_ble_mode_summary"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sa_space_hairline" android:textSize="@dimen/sa_type_caption" android:textColor="@color/sa_text_tertiary"/>
                        </LinearLayout>
                        <ImageView
                            style="@style/SA.ChevronRight"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Settings card (PIN protected) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/sa_space_sm"
                    android:foreground="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardCornerRadius="@dimen/sa_radius_md"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/sa_surface_alt">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/sa_space_lg"
                        android:paddingVertical="@dimen/sa_space_md"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="@dimen/sa_icon_badge"
                            android:layout_height="@dimen/sa_icon_badge"
                            android:gravity="center"
                            android:background="@drawable/shape_icon_bg_gray"
                            android:layout_marginEnd="14dp">
                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@android:drawable/ic_menu_preferences"
                                android:contentDescription="Settings"
                                android:tint="@color/sa_text_tertiary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="개발자 설정"
                                android:textSize="@dimen/sa_type_section"
                                android:textStyle="bold"
                                android:textColor="@color/sa_text_secondary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sa_space_hairline"
                                android:text="PIN 입력 필요"
                                android:textSize="@dimen/sa_type_caption"
                                android:textColor="@color/sa_text_tertiary" />
                        </LinearLayout>

                        <ImageView
                            style="@style/SA.ChevronRight"
                            android:contentDescription="@null" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Permission warning -->
            <LinearLayout
                android:id="@+id/layout_permission_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/shape_warning_bg"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_permission_msg"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="@dimen/sa_type_caption"
                    android:textColor="@color/sa_warning" />

                <TextView
                    android:id="@+id/btn_grant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/sa_space_sm"
                    android:text="허용"
                    android:textSize="@dimen/sa_type_caption"
                    android:textStyle="bold"
                    android:textColor="@color/sa_warning_dim"
                    android:padding="@dimen/sa_space_xs"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Pinned to the bottom: version + credit (set at runtime from BuildConfig.VERSION_NAME) -->
    <TextView
        android:id="@+id/tv_version_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:gravity="center"
        android:text="v1.0.0  ·  Created by Ian"
        android:textSize="@dimen/sa_type_hint"
        android:textColor="@color/sa_text_tertiary"
        android:letterSpacing="0.05"
        android:background="@color/sa_bar" />

</LinearLayout>

    <!-- Startup splash — shown for 1.5 s, then MainActivity fades it out. clickable blocks touches to the UI below;
         on screen re-creation (rotation etc.) onCreate hides it immediately -->
    <ImageView
        android:id="@+id/iv_splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_splash"
        android:background="@color/sa_bg"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@null" />

</FrameLayout>
