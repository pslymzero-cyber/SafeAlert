<?xml version="1.0" encoding="utf-8"?>
<!-- Equipment picker dropdown — each row of the open list. 64dp touch target. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="64dp"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/sa_space_lg"
    android:paddingEnd="@dimen/sa_space_lg"
    android:background="@color/sa_surface"
    android:textSize="@dimen/sa_type_display"
    android:textColor="@color/sa_text_primary"
    android:singleLine="true"
    android:ellipsize="end" />
