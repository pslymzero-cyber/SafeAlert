<?xml version="1.0" encoding="utf-8"?>
<!--
  On-screen alert sidebar — an edge panel docked flush to the screen edge.
    · The root has only two mutually exclusive children; the visible one sets the sidebar width.
        Collapsed (normal)               = overlay_handle only → 20dp wide. Covers practically nothing.
        Expanded (alert, process change) = overlay_panel only  → 236dp wide.
    · The point is to shrink the width itself when collapsed: a 236dp card left on screen
      would be a floating widget, not a sidebar.
    · Outer corners are square (shape_overlay_panel_end/start). Rounded ones open a gap at the
      screen edge and it looks like a 'floating card' again.
    · The header row (overlay_header) and the handle are the drag grips. The list takes touches first,
      so the listeners go on these two, not on the root.
    · All colors are SA tokens; no literal colors in code. Spacing and text sizes use SA dimens.
    · No Material widgets — this is inflated from a Service context, so only plain widgets are used.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- Collapsed state. The only element that normally stays on screen. -->
    <FrameLayout
        android:id="@+id/overlay_handle"
        android:layout_width="20dp"
        android:layout_height="96dp"
        android:background="@drawable/shape_overlay_handle_end">

        <View
            android:id="@+id/overlay_handle_grip"
            android:layout_width="3dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:background="@drawable/shape_overlay_grip" />
    </FrameLayout>

    <!-- Expanded state. -->
    <LinearLayout
        android:id="@+id/overlay_panel"
        android:layout_width="236dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/shape_overlay_panel_end"
        android:paddingBottom="@dimen/sa_space_sm"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/overlay_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/sa_space_md"
            android:paddingEnd="@dimen/sa_space_md"
            android:paddingTop="@dimen/sa_space_sm"
            android:paddingBottom="@dimen/sa_space_sm">

            <View
                android:id="@+id/overlay_grip"
                android:layout_width="20dp"
                android:layout_height="4dp"
                android:layout_marginEnd="@dimen/sa_space_sm"
                android:background="@drawable/shape_overlay_grip" />

            <TextView
                android:id="@+id/overlay_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="@dimen/sa_type_section"
                android:textStyle="bold"
                android:textColor="@color/sa_text_primary"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="위험 감지" />

            <!-- Shown only when expanded with zero hazards. Tells the user that tapping the header enters process change. -->
            <TextView
                android:id="@+id/overlay_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sa_space_sm"
                android:textSize="@dimen/sa_type_hint"
                android:textColor="@color/sa_accent"
                android:maxLines="1"
                android:text="공정 변경"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:id="@+id/overlay_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sa_stroke_hairline"
            android:background="@color/sa_divider" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/overlay_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/sa_space_sm"
            android:paddingEnd="@dimen/sa_space_sm"
            android:paddingTop="@dimen/sa_space_sm"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/overlay_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/sa_space_md"
            android:paddingEnd="@dimen/sa_space_md"
            android:paddingTop="@dimen/sa_space_sm"
            android:textSize="@dimen/sa_type_hint"
            android:textColor="@color/sa_text_tertiary"
            android:maxLines="2"
            android:text="행 탭 = 30초 확인 · 손잡이를 옆으로 끝까지 밀면 전체 확인" />

        <!-- Shown only when expanded with zero hazards. The only way to collapse again (it never collapses during an alert). -->
        <TextView
            android:id="@+id/overlay_collapse"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/sa_space_md"
            android:paddingEnd="@dimen/sa_space_md"
            android:paddingTop="@dimen/sa_space_sm"
            android:paddingBottom="@dimen/sa_space_xs"
            android:textSize="@dimen/sa_type_hint"
            android:textColor="@color/sa_text_tertiary"
            android:maxLines="1"
            android:text="닫기"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
