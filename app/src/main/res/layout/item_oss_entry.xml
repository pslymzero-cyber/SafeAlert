<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <!-- 라이브러리명 + 설명 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/tv_oss_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sa_type_body"
            android:textStyle="bold"
            android:textColor="@color/sa_text_primary"
            android:text="Library Name"/>
        <TextView
            android:id="@+id/tv_oss_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/sa_type_hint"
            android:textColor="@color/sa_text_tertiary"
            android:text="v0.0.0"/>
    </LinearLayout>

    <!-- 라이선스 뱃지 -->
    <TextView
        android:id="@+id/tv_oss_license"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/sa_space_sm"
        android:paddingVertical="3dp"
        android:background="@drawable/bg_license_badge"
        android:textSize="@dimen/sa_type_micro"
        android:textColor="@color/sa_accent"
        android:text="Apache 2.0"/>

</LinearLayout>
