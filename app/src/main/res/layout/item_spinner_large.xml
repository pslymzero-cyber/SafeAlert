<?xml version="1.0" encoding="utf-8"?>
<!--
  Equipment picker dropdown — closed state (the selected value).
  Text and height are enlarged for gloved hands and bright warehouse lighting; the default Spinner item
  is unreadable in the field.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/sa_space_lg"
    android:paddingEnd="@dimen/sa_space_xxl"
    android:paddingTop="@dimen/sa_space_md"
    android:paddingBottom="@dimen/sa_space_md"
    android:textSize="@dimen/sa_type_display"
    android:textStyle="bold"
    android:textColor="@color/sa_text_primary"
    android:singleLine="true"
    android:ellipsize="end" />
