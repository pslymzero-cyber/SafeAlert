<?xml version="1.0" encoding="utf-8"?>
<!-- (v1.1.63) BLE 감지 설정 — 아코디언 3섹션([경보 기본] 기본 펼침 · [비콘]·[UWB] 접힘).
     공통 스타일 SA.* (values/themes.xml). 섹션 헤더 탭=펼침/접힘 토글, 헤더 요약값은 BleSettingsActivity.updateSectionSummaries() 가 갱신.
     이동: 경보 볼륨(개발자→여기, 50~100%) · 에코편차 자동보정 스위치+하위 항목(개발자→여기, 행 탭=하위 펼침) /
           협력 2종(상호 RSSI·완화)·UWB 승격 3종 → 개발자 설정. EPJ↔EPJ 오프셋은 [v1.1.60] gone 그대로 보존. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/sa_bg">

    <!-- 상단 헤더 바 -->
    <LinearLayout style="@style/SA.TopBar">
        <TextView
            style="@style/SA.TopBarTitle"
            android:text="BLE 감지 설정" />
    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/sa_stroke_hairline"
        android:background="@color/sa_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/sa_space_lg">

            <!-- ═══════════ [경보 기본] — 기본 펼침 ═══════════ -->
            <androidx.cardview.widget.CardView style="@style/SA.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/sec_alert_header"
                        style="@style/SA.SectionHeader">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/SA.SectionTitle"
                                android:text="경보 기본" />
                            <TextView
                                android:id="@+id/sec_alert_summary"
                                style="@style/SA.SectionSummary"
                                android:text="경고 -75 · 위험 -80 dBm · 볼륨 100%" />
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/sec_alert_chevron"
                            style="@style/SA.Chevron"
                            android:rotation="180"
                            android:contentDescription="펼침/접힘" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sec_alert_body"
                        style="@style/SA.SectionBody"
                        android:visibility="visible">

                        <!-- 칼만 필터 (신호세기 기반) -->
                        <TextView
                            style="@style/SA.Hint"
                            android:layout_marginTop="0dp"
                            android:text="칼만 필터 (신호세기 기반) · 신호세기(dBm)를 직접 설정 · 노이즈 자동 억제" />

                        <TextView
                            style="@style/SA.Label"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="6dp"
                            android:text="필터 강도" />

                        <RadioGroup
                            android:id="@+id/rg_kalman_preset"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="6dp">
                            <RadioButton
                                android:id="@+id/rb_kf_fast"
                                style="@style/SA.Radio"
                                android:text="빠른 반응" />
                            <RadioButton
                                android:id="@+id/rb_kf_normal"
                                style="@style/SA.Radio"
                                android:text="균형" />
                            <RadioButton
                                android:id="@+id/rb_kf_smooth"
                                style="@style/SA.Radio"
                                android:text="강한 평활" />
                        </RadioGroup>

                        <LinearLayout style="@style/SA.Row">
                            <TextView
                                style="@style/SA.RowLabel"
                                android:text="경고 신호세기" />
                            <TextView
                                android:id="@+id/tv_warn_dist"
                                style="@style/SA.Value"
                                android:textColor="@color/sa_warning"
                                android:text="-75 dBm" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/seek_warn_dist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sa_space_xs"
                            android:min="30"
                            android:max="100" />

                        <LinearLayout style="@style/SA.Row">
                            <TextView
                                style="@style/SA.RowLabel"
                                android:text="위험 신호세기" />
                            <TextView
                                android:id="@+id/tv_dang_dist"
                                style="@style/SA.Value"
                                android:textColor="@color/sa_danger"
                                android:text="-80 dBm" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/seek_dang_dist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sa_space_xs"
                            android:min="30"
                            android:max="100" />

                        <View style="@style/SA.Divider" />

                        <!-- 경보 볼륨 — (v1.1.63) 개발자 설정에서 이동 · 50% 미만 설정 불가 -->
                        <LinearLayout style="@style/SA.Row">
                            <TextView
                                style="@style/SA.RowLabel"
                                android:text="경보 볼륨" />
                            <TextView
                                android:id="@+id/tv_alarm_volume_val"
                                style="@style/SA.Value"
                                android:text="100%" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/seek_alarm_volume"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sa_space_xs"
                            android:min="50"
                            android:max="100" />
                        <TextView
                            style="@style/SA.Hint"
                            android:text="50~100% (50% 미만 설정 불가) · 진동/무음 모드에서도 알람 스트림으로 강제 출력됩니다" />

                        <View style="@style/SA.Divider" />

                        <!-- 에코편차 자동보정 (Level 2) — (v1.1.63) 개발자 설정에서 이동 · 기본 켜짐.
                             스위치 행만 표시, 행(스위치 밖)을 누르면 아래 통계·보정 항목이 펼쳐짐 -->
                        <LinearLayout
                            android:id="@+id/row_echo_auto_calib"
                            style="@style/SA.Row"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">
                            <TextView
                                style="@style/SA.RowLabel"
                                android:text="에코편차 자동보정 (상호 RSSI)" />
                            <ImageView
                                android:id="@+id/iv_echo_chevron"
                                style="@style/SA.Chevron"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="0dp"
                                android:layout_marginEnd="6dp"
                                android:contentDescription="보정 항목 펼침/접힘" />
                            <Switch
                                android:id="@+id/sw_echo_auto_calib"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <TextView
                            style="@style/SA.Hint"
                            android:layout_marginTop="@dimen/sa_space_hairline"
                            android:text="기본 켜짐 · 기기쌍별 상호 RSSI 편차 중앙값으로 판정 임계를 자동 보정 · 행을 누르면 통계·보정 항목 표시" />

                        <LinearLayout
                            android:id="@+id/echo_detail_group"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                style="@style/SA.Hint"
                                android:layout_marginTop="@dimen/sa_space_sm"
                                android:text="켜면 기기쌍별 중앙값의 −1/2 을 클램프로 잘라 판정 임계에 반영합니다(거울쌍 양쪽 수렴). 표본 부족 시 Firebase 모델쌍 프라이어로 시작, 산포 과다 기기는 보정 0. 기본 켜짐." />

                            <TextView
                                android:id="@+id/tv_echo_diag"
                                style="@style/SA.Mono"
                                android:layout_marginTop="10dp"
                                android:text="수집된 에코 표본 없음" />
                            <TextView
                                style="@style/SA.Hint"
                                android:text="편차 = 내가 측정한 상대 RSSI − 상대가 나를 측정해 되돌린 에코. 중앙값=기기 간 체계적 비대칭(모델별 오프셋의 실측 근거), 산포=채널 노이즈(보정 불가 성분), 에코%=상호 RSSI 응답 비율(0%=비콘·구버전). 수집은 판정과 독립이며 앱을 재시작해도 누적됩니다. 자동보정이 켜지면 이 통계의 중앙값이 판정 임계 보정(echoCal)에 사용됩니다." />

                            <LinearLayout style="@style/SA.Row">
                                <TextView
                                    style="@style/SA.RowLabel"
                                    android:text="보정 성립 최소 에코틱 (n)" />
                                <EditText
                                    android:id="@+id/et_echo_min_ticks"
                                    style="@style/SA.EditNumber" />
                            </LinearLayout>
                            <LinearLayout style="@style/SA.Row">
                                <TextView
                                    style="@style/SA.RowLabel"
                                    android:text="산포 상한 (±dB, 초과=보정 0)" />
                                <EditText
                                    android:id="@+id/et_echo_max_iqr"
                                    style="@style/SA.EditNumber" />
                            </LinearLayout>
                            <LinearLayout style="@style/SA.Row">
                                <TextView
                                    style="@style/SA.RowLabel"
                                    android:text="보정 클램프 (±dB)" />
                                <EditText
                                    android:id="@+id/et_echo_clamp"
                                    style="@style/SA.EditNumber" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/btn_echo_reset"
                                style="@style/SA.Button"
                                android:layout_marginTop="10dp"
                                android:backgroundTint="@color/sa_tint_gray"
                                android:textColor="@color/sa_text_secondary"
                                android:text="에코편차 통계 초기화" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ═══════════ [비콘] — 접힘 ═══════════ -->
            <androidx.cardview.widget.CardView style="@style/SA.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/sec_beacon_header"
                        style="@style/SA.SectionHeader">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/SA.SectionTitle"
                                android:text="비콘" />
                            <TextView
                                android:id="@+id/sec_beacon_summary"
                                style="@style/SA.SectionSummary"
                                android:text="수신 강도 100%" />
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/sec_beacon_chevron"
                            style="@style/SA.Chevron"
                            android:contentDescription="펼침/접힘" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sec_beacon_body"
                        style="@style/SA.SectionBody">

                        <LinearLayout
                            style="@style/SA.Row"
                            android:layout_marginTop="0dp">
                            <TextView
                                style="@style/SA.RowLabel"
                                android:text="비콘 수신 강도" />
                            <TextView
                                android:id="@+id/tv_beacon_gain"
                                style="@style/SA.Value"
                                android:text="100%" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/seek_beacon_gain"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sa_space_xs"
                            android:max="30" />
                        <TextView
                            style="@style/SA.Hint"
                            android:text="등록된 모든 비콘의 감지 범위를 비율로 일괄 조절 · 100% = 기본" />

                        <!-- [v1.1.60] EPJ 비하인드 — 3요소 gone(핸들러·저장 로직 보존, 부활 시 visibility 만 제거) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">
                            <TextView
                                style="@style/SA.SubHeader"
                                android:text="EPJ끼리 근접 경보" />
                            <TextView
                                style="@style/SA.Hint"
                                android:layout_marginTop="@dimen/sa_space_hairline"
                                android:text="EPJ끼리는 5m 공존이 정상 · 값을 낮출수록(음수) 더 가까이(3m) 와야 울림" />
                            <LinearLayout style="@style/SA.Row">
                                <TextView
                                    style="@style/SA.RowLabel"
                                    android:text="조기경보 오프셋" />
                                <TextView
                                    android:id="@+id/tv_epj_bias"
                                    style="@style/SA.Value"
                                    android:text="-2 dB" />
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/seek_epj_bias"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/sa_space_xs"
                                android:max="25" />
                            <TextView
                                style="@style/SA.Hint"
                                android:text="-10 ~ +15 dB (기본 -2). 0=일반 임계 · 음수=더 가까이서만(거리 변별) · 양수=더 멀리서 미리. 지게차가 끼면 장비↔장비 오프셋 적용." />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ═══════════ [UWB] — 접힘 ═══════════ -->
            <androidx.cardview.widget.CardView style="@style/SA.Card">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/sec_uwb_header"
                        style="@style/SA.SectionHeader">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                style="@style/SA.SectionTitle"
                                android:text="UWB 정밀 거리 측정" />
                            <TextView
                                android:id="@+id/sec_uwb_summary"
                                style="@style/SA.SectionSummary"
                                android:text="켜짐 · 지게차 쌍 15/8m · 그 외 5/3m" />
                        </LinearLayout>
                        <ImageView
                            android:id="@+id/sec_uwb_chevron"
                            style="@style/SA.Chevron"
                            android:contentDescription="펼침/접힘" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/sec_uwb_body"
                        style="@style/SA.SectionBody">

                        <TextView
                            style="@style/SA.Hint"
                            android:layout_marginTop="0dp"
                            android:text="지원 기기끼리 실거리(m)를 측정 · UWB 신호가 오는 상대는 실측 거리로, 그 외는 BLE 신호로 경보 판정" />

                        <LinearLayout style="@style/SA.Row">
                            <TextView
                                style="@style/SA.RowLabel"
                                android:text="UWB 사용" />
                            <Switch
                                android:id="@+id/sw_uwb"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tv_uwb_hint"
                            style="@style/SA.Hint"
                            android:layout_marginTop="@dimen/sa_space_hairline"
                            android:text="기본 켜짐 · UWB 신호가 오는 동안은 실측 거리로만 경고/위험 판정 · 신호가 없으면 BLE 신호로 판정" />

                        <Button
                            android:id="@+id/btn_uwb_permission"
                            style="@style/SA.Button"
                            android:layout_marginTop="@dimen/sa_space_md"
                            android:text="UWB 권한 허용 / 시스템 UWB 설정" />
                        <TextView
                            android:id="@+id/tv_uwb_system_hint"
                            style="@style/SA.Hint"
                            android:text="UWB로 거리가 m 로 표시되려면: ① 이 버튼으로 UWB 권한 허용 ② 기기 UWB(시스템) 켜짐 ③ 상대 기기도 UWB 지원. 하나라도 빠지면 신호세기(dBm)로 표시됩니다." />

                        <TextView
                            style="@style/SA.Label"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="6dp"
                            android:text="거리 표시 방식" />
                        <RadioGroup
                            android:id="@+id/rg_dist_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <RadioButton
                                android:id="@+id/rb_dist_dbm"
                                style="@style/SA.Radio"
                                android:text="dBm" />
                            <RadioButton
                                android:id="@+id/rb_dist_uwb_m"
                                style="@style/SA.Radio"
                                android:text="UWB만 m" />
                            <RadioButton
                                android:id="@+id/rb_dist_all_m"
                                style="@style/SA.Radio"
                                android:text="전부 m" />
                        </RadioGroup>
                        <TextView
                            style="@style/SA.Hint"
                            android:layout_marginTop="@dimen/sa_space_hairline"
                            android:text="전부 m: UWB 페어는 실측, 그 외는 신호 기반 추정(약 X m)" />

                        <TextView
                            style="@style/SA.Label"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="@dimen/sa_space_xs"
                            android:text="사업장 코드 (보정 프로파일)" />
                        <EditText
                            android:id="@+id/et_uwb_site"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="예: WF11 (빈 값 = 공용 프로파일)"
                            android:textSize="@dimen/sa_type_body"
                            android:textColor="@color/sa_text_secondary"
                            android:inputType="text"
                            android:maxLines="1" />
                        <TextView
                            style="@style/SA.Hint"
                            android:layout_marginTop="@dimen/sa_space_hairline"
                            android:text="UWB 보정 학습값을 사업장별로 저장·전환 · 사업장 학습은 지워지지 않고 코드 변경 시 즉시 불러옴" />

                        <View style="@style/SA.Divider" />

                        <TextView
                            style="@style/SA.SubHeader"
                            android:text="UWB 판정 반경" />
                        <TextView
                            style="@style/SA.Hint"
                            android:layout_marginTop="@dimen/sa_space_hairline"
                            android:text="UWB 실측 신호가 오는 상대에게 적용 · 지게차가 낀 쌍/그 외 쌍 각각 경고·위험 거리" />

                        <LinearLayout style="@style/SA.Row">
                            <TextView
                                style="@style/SA.RowLabel"
                                android:text="지게차 쌍 경고" />
                            <TextView
                                android:id="@+id/tv_uwb_fk_warn"
                                style="@style/SA.Value"
                                android:textColor="@color/sa_warning"
                                android:text="15m" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/seek_uwb_fk_warn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sa_space_xs"
                            android:min="2"
                            android:max="80" />

                        <LinearLayout style="@style/SA.Row">
                            <TextView
                                style="@style/SA.RowLabel"
                                android:text="지게차 쌍 위험" />
                            <TextView
                                android:id="@+id/tv_uwb_fk_danger"
                                style="@style/SA.Value"
                                android:textColor="@color/sa_danger"
                                android:text="8m" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/seek_uwb_fk_danger"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sa_space_xs"
                            android:min="1"
                            android:max="60" />

                        <LinearLayout style="@style/SA.Row">
                            <TextView
                                style="@style/SA.RowLabel"
                                android:text="그 외 쌍 경고" />
                            <TextView
                                android:id="@+id/tv_uwb_pair_warn"
                                style="@style/SA.Value"
                                android:textColor="@color/sa_warning"
                                android:text="5m" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/seek_uwb_pair_warn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sa_space_xs"
                            android:min="2"
                            android:max="40" />

                        <LinearLayout style="@style/SA.Row">
                            <TextView
                                style="@style/SA.RowLabel"
                                android:text="그 외 쌍 위험" />
                            <TextView
                                android:id="@+id/tv_uwb_pair_danger"
                                style="@style/SA.Value"
                                android:textColor="@color/sa_danger"
                                android:text="3m" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/seek_uwb_pair_danger"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/sa_space_xs"
                            android:min="1"
                            android:max="30" />
                        <TextView
                            style="@style/SA.Hint"
                            android:text="기본: 지게차 쌍 15m 경고·8m 위험 / 그 외 5m 경고·3m 위험 · 0.5m 단위 즉시 반영" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
